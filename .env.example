# Copy to .env (gitignored). Never commit real values.
# NORR_MOCK=1 stubs 1Click and the TEE so the whole flow runs locally with no funds.
NORR_MOCK=1
# Partner JWT from https://partners.near-intents.org (sent as X-API-Key; avoids the extra 0.25% fee)
ONECLICK_API_KEY=
ONECLICK_BASE_URL=https://1click.chaindefuser.com
NEAR_NETWORK=mainnet

# OutLayer Agent Custody (key shown once at POST /register; never commit)
OUTLAYER_API_KEY=
OUTLAYER_BASE_URL=https://api.outlayer.ai

# NEAR Intents Shield incident feed. Needs a key of type SHIELD (create one at
# https://partners.near-intents.org/api-keys); the 1Click distribution key is rejected.
# Without it the Shield check fails closed and every live trade is blocked.
SHIELD_API_KEY=
# Live mode: the vault's custody wallet account (its implicit NEAR account) and its policy file.
OUTLAYER_ACCOUNT_ID=
NORR_POLICY_FILE=
# Optional dev-only owner controls (pause/resume) until NEAR-signed owner sessions land.
NORR_ADMIN_TOKEN=

# Environment: "dev", "demo" or "production". Unset counts as production (the strictest).
NORR_ENV=
# Shield behavior when the feed is unreachable. Leave unset (= "enforce", fail closed).
# "dev-bypass" lets live trades through ONLY when the feed is down, and ONLY with NORR_ENV=dev;
# the service refuses to start with it in demo or production, and an incident still blocks.
SHIELD_MODE=
