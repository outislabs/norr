{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src",
    "apps/*/src",
    "apps/landing/build",
    "scripts"
  ],
  "exclude": [
    "apps/web",
    "node_modules"
  ]
}
