{
  "name": "norr",
  "private": true,
  "version": "0.0.0",
  "description": "Private trading layer for AI agents on NEAR Intents",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
