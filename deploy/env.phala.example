# Copy to deploy/.env.phala (gitignored) and fill in. Values here are sealed by `phala deploy -e`: only the CVM can read them.
# See docs/FIRST-DEPLOY.md. Do not paste any of these into chat or commit them.

# Not secret
NORR_OWNER_ACCOUNT=norrfi.near
# The dashboard's origin, exactly (no path, no trailing slash). Create the Cloudflare Pages project first so this is known.
NORR_ALLOWED_ORIGINS=https://app.norr.finance
# The vault's starting policy as one line of JSON (from config/policy.demo.local.json). Seeds the first boot only.
NORR_POLICY_JSON=

# Secret
# openssl rand -base64 32   -- and keep a copy offline: if it is lost the service's saved data cannot be read.
NORR_DATA_KEY=
OUTLAYER_DEMO_API_KEY=
OUTLAYER_DEMO_ACCOUNT_ID=
OUTLAYER_DEMO_WALLET_ID=
ONECLICK_API_KEY=
# Required: without it every trade is blocked (the Shield check fails closed). Never set NORR_ENV or SHIELD_MODE here.
SHIELD_API_KEY=
